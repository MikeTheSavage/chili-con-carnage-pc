<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Merged into the executable's manifest by the build. Says the program is written for Windows 10 and 11,
     so Windows applies no compatibility behaviour of older versions. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="ChiliConCarnage.PC" version="0.9.0.0" processorArchitecture="amd64"/>
  <description>Chili Con Carnage (native PC port)</description>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
