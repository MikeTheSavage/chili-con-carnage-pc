!/profiles/chili/launcher/test/sample_ChiliNative.ini
launcher.ini
extraction_manifest.json

# What a builder makes from their own copy: the extracted disc, the generated corpus (C++ made from the
# game's executable), captures of runs, notes
/profiles/*/game/
/profiles/*/analysis/
/profiles/*/captures/
/profiles/*/progress/
/profiles/*/symbols/
generated_unit_*.cpp
generated_registry.cpp
generated_units.hpp

